  .final .lead { margin: 30px auto 38px; }
  .btn-lg { padding: 20px 38px; font-size: 1.06rem; }
</style>

<script is:inline>
  (function () {
    /* Fechamento de contas: o emaranhado colapsa em dois pagamentos */
    var settle = document.getElementById("settle");
    var sBtn = document.getElementById("settleBtn");
    if (settle && sBtn) {
      sBtn.addEventListener("click", function () { settle.classList.add("done"); });
      var sio = new IntersectionObserver(function (en) {
        en.forEach(function (e) {
          if (!e.isIntersecting) return;
          sio.unobserve(e.target);
          setTimeout(function () { settle.classList.add("done"); }, 3400);
        });
      }, { threshold: 0.45 });
      sio.observe(settle);
    }

    /* Simulador de parcelamento */
    var range = document.getElementById("simRange");
    var simN = document.getElementById("simN");
    var simV = document.getElementById("simV");
    if (range && simN && simV) {
      var TOTAL = 4280;
      var upd = function () {
        var n = parseInt(range.value, 10);
        simN.textContent = n;
        simV.textContent = Math.round(TOTAL / n).toLocaleString("pt-BR");
      };
      range.addEventListener("input", upd);
      upd();
    }

    /* Barras do cofrinho e elementos que se desenham (trilha, anel) */
    var gio = new IntersectionObserver(function (en) {
      en.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("in"); gio.unobserve(e.target); }
      });
    }, { threshold: 0.35 });
    document.querySelectorAll(".bar-row, .trilha, .ring-box").forEach(function (el) { gio.observe(el); });

    /* Checklist que se marca sozinho, item por item */
    var ck = document.querySelector(".ck");
    if (ck) {
      var kio = new IntersectionObserver(function (en) {
        en.forEach(function (e) {
          if (!e.isIntersecting) return;
          kio.unobserve(e.target);
          Array.prototype.forEach.call(ck.children, function (li, i) {
            setTimeout(function () { li.classList.add("on"); }, 300 + i * 270);
          });
        });
      }, { threshold: 0.4 });
      kio.observe(ck);
    }

    /* Enquete clicavel */
    var poll = document.getElementById("poll");
    if (poll) {
      var opts = [].slice.call(poll.querySelectorAll(".opt"));
      var votos = opts.map(function (o) { return parseInt(o.getAttribute("data-v"), 10); });
      var votou = false;
      var render = function () {
        var tot = votos.reduce(function (a, b) { return a + b; }, 0);
        var maior = Math.max.apply(null, votos);
        opts.forEach(function (o, i) {
          o.querySelector(".opt-fill").style.setProperty("--w", (votos[i] / tot) * 100 + "%");
          o.querySelector(".opt-n").textContent = votos[i];
          o.classList.toggle("win", votos[i] === maior);
        });
      };
      opts.forEach(function (o, i) {
        o.addEventListener("click", function () {
          if (votou) return;
          votou = true;
          votos[i] += 1;
          render();
          poll.querySelector(".poll-f").textContent = "Decidido. 10 pessoas no grupo.";
        });
      });
      render();
    }

    /* Abas de topico */
    document.querySelectorAll(".tabs").forEach(function (tabs) {
      tabs.addEventListener("click", function (ev) {
        var t = ev.target.closest(".tab");
        if (!t) return;
        tabs.querySelectorAll(".tab").forEach(function (x) { x.classList.remove("on"); });
        t.classList.add("on");
      });
    });

    /* Contador regressivo ao vivo */
    var cdD = document.getElementById("cdD");
    if (cdD) {
      var alvo = new Date();
      alvo.setDate(alvo.getDate() + 23);
      alvo.setHours(alvo.getHours() + 7, alvo.getMinutes() + 42, alvo.getSeconds() + 18);
      var p2 = function (n) { return String(n).padStart(2, "0"); };
      var tick = function () {
        var ms = alvo - new Date();
        if (ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        cdD.textContent = Math.floor(s / 86400);
        document.getElementById("cdH").textContent = p2(Math.floor((s % 86400) / 3600));
        document.getElementById("cdM").textContent = p2(Math.floor((s % 3600) / 60));
        document.getElementById("cdS").textContent = p2(s % 60);
      };
      tick();
      setInterval(tick, 1000);
    }
  })();
</script>
