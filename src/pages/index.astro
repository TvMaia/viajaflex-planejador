  @keyframes slidein { from { opacity: 0; transform: translateY(-10px); } }
  @media (max-width: 880px) { .faq-in { grid-template-columns: 1fr; } .faq-l { position: static; } }

  /* ===== 16. FINAL ===== */
  .final { padding-block: clamp(120px, 17vh, 200px); }
