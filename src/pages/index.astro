  .cl-c em { font-family: var(--ff-mono); font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--vf-faint); font-style: normal; }
  .cl-c.c3 { transform: translateY(0) scale(0.9); }
  .cl-c.c2 { transform: translateY(0) scale(0.95); }
  .bento-i.in .cl-c { opacity: 1; }
  .bento-i.in .cl-c.c3 { transform: translateY(-82px) scale(0.86); opacity: 0.45; transition-delay: 0.1s; }
  .bento-i.in .cl-c.c2 { transform: translateY(-42px) scale(0.93); opacity: 0.7; transition-delay: 0.22s; }
  .bento-i.in .cl-c.c1 { transition-delay: 0.34s; }

  /* bloco largo: barra de link publico */
  .bn-link { align-items: center; }
  .lk-bar {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 12px 14px; border-radius: 12px;
    background: rgba(7, 10, 20, 0.74);
    border: 1px solid color-mix(in srgb, var(--tint) 30%, var(--vf-line));
  }
  .lk-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--tint); flex: none; box-shadow: 0 0 12px var(--tint); }
  .lk-url { font-family: var(--ff-mono); font-size: 0.76rem; color: var(--vf-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lk-url b { color: var(--vf-ink); }
  .lk-cp {
    margin-left: auto; flex: none; font-family: var(--ff-mono); font-size: 0.6rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--tint);
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tint) 38%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-l, .cl-c { opacity: 1; transform: none; }
    .pr-bar { transform: scaleX(1); }
  }
  .bento-i.wide { grid-column: span 2; }
  @media (max-width: 1000px) { .bento { grid-template-columns: repeat(2, 1fr); } .bento-i.big { grid-column: span 2; grid-row: auto; } .bento-i.tall { grid-row: auto; } }
  @media (max-width: 620px) { .bento { grid-template-columns: 1fr; } .bento-i.big, .bento-i.wide { grid-column: auto; } }

  /* ===== 13. PROGRESSO ===== */
  .prog-in { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(34px, 5vw, 76px); align-items: center; }
  .ring-box { position: relative; max-width: 290px; width: 100%; margin-inline: auto; }
  .ring { width: 100%; transform: rotate(-90deg); display: block; }
  .ring circle { fill: none; stroke-width: 10; stroke-linecap: round; }
  .ring-bg { stroke: rgba(242, 247, 255, 0.06); }
  .ring-fg { stroke: var(--tint); stroke-dasharray: 540; stroke-dashoffset: 540; transition: stroke-dashoffset 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s; }
  .ring-box.in .ring-fg { stroke-dashoffset: 162; }
  .ring-c { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 6px; }
  .ring-c strong { font-size: clamp(1.8rem, 3.4vw, 2.6rem); color: var(--vf-ink); line-height: 1; }
  .ring-c span { font-family: var(--ff-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--vf-faint); }
  .prog-txt p { font-size: 1rem; }
  @media (max-width: 860px) { .prog-in { grid-template-columns: 1fr; } }

  /* ===== 14. DEPOIMENTOS ===== */
  .depo .eyebrow { font-size: 0.82rem; letter-spacing: 0.28em; }
  .depo-g { margin-top: 52px; gap: clamp(20px, 2.4vw, 32px); }
  .quote { display: flex; flex-direction: column; gap: 26px; padding: 62px 34px 34px; }
  .qm { position: absolute; top: 22px; left: 32px; font-family: var(--ff-display); font-size: 5.4rem; line-height: 1; color: var(--tint); opacity: 0.34; }
  .quote blockquote { margin: 0; font-family: var(--ff-display); font-size: clamp(1.18rem, 1.45vw, 1.42rem); line-height: 1.52; color: var(--vf-ink); flex: 1; text-wrap: pretty; }
  .quote figcaption { display: flex; flex-direction: column; gap: 5px; margin: 0; padding-top: 22px; border-top: 1px solid var(--vf-line); }
  .quote figcaption b { font-family: var(--ff-display); font-size: 1.14rem; font-weight: 600; color: var(--vf-ink); letter-spacing: 0; text-transform: none; }
  .quote figcaption span { font-family: var(--ff-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vf-muted); }
  .depo-note { text-align: center; font-family: var(--ff-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--vf-faint); margin-top: 42px; }

  /* ===== 15. FAQ ===== */
  .faq-in { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(32px, 5vw, 76px); align-items: start; }
  .faq-l { position: sticky; top: 110px; }
  details { border-bottom: 1px solid var(--vf-line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; cursor: pointer; list-style: none; font-family: var(--ff-display); font-size: clamp(1.02rem, 1.5vw, 1.2rem); font-weight: 500; color: var(--vf-ink); transition: color 0.3s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--tint); }
  .plus { position: relative; width: 16px; height: 16px; flex: none; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--tint); border-radius: 2px; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  .ans p { padding-bottom: 26px; margin: 0; max-width: 62ch; font-size: 0.98rem; }
