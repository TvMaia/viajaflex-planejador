  @keyframes tagpulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--vf-green) 65%, transparent); } 70%, 100% { box-shadow: 0 0 0 11px transparent; } }
  .tag-tx { font-family: var(--ff-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--vf-ink); }
